model User {
    id       String @id @default(uuid())
    name     String
    email    String @unique
    password String

    role       Role       @default(CUSTOMER)
    userStatus UserStatus @default(ACTIVE)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    gearItems    GearItem[]
    rentalOrders RentalOrder[]
    reviews      Review[]
}
